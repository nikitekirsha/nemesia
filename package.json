{
	"name": "nemesia",
	"version": "2.4.1",
	"description": "DOM-first runtime for server-rendered websites",
	"type": "module",
	"sideEffects": false,
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^20.19.0 || >=22.12.0"
		}
	},
	"main": "./dist/nemesia.js",
	"module": "./dist/nemesia.js",
	"types": "./dist/index.d.ts",
	"unpkg": "./dist/nemesia.umd.js",
	"jsdelivr": "./dist/nemesia.umd.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/nemesia.js",
			"default": "./dist/nemesia.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nikitekirsha/nemesia.git"
	},
	"keywords": [
		"nemesia",
		"components",
		"lifecycle",
		"vanilla",
		"dom",
		"progressive-enhancement"
	],
	"author": "nikitekirsha",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/nikitekirsha/nemesia/issues"
	},
	"homepage": "https://nikitekirsha.github.io/nemesia/",
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"bench": "vitest bench --run",
		"bench:browser": "vitest bench --run --config vitest.browser.config.ts",
		"typecheck": "tsc --noEmit",
		"build": "vite build && vite build --config vite.umd.config.ts && tsc -p tsconfig.build.json && tsc -p tests/consumer/tsconfig.json && node --test scripts/verify-build.test.mjs && node scripts/verify-build.mjs",
		"precommit": "npm run format:check && npm run typecheck && npm run test:coverage",
		"verify": "npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm pack --dry-run --ignore-scripts",
		"prepack": "npm run format:check && npm run test:coverage && npm run typecheck && npm run build",
		"prepare": "husky"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@vitest/browser-playwright": "^4.1.12",
		"@vitest/coverage-v8": "^4.1.12",
		"husky": "^9.1.7",
		"jsdom": "^26.1.0",
		"playwright": "^1.65.0",
		"prettier": "^3.9.5",
		"terser": "^5.51.2",
		"typescript": "^5.8.3",
		"vite": "^7.0.0",
		"vitest": "^4.1.12"
	}
}
