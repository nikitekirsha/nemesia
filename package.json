{
  "name": "nemesia",
  "version": "2.0.0",
  "description": "DOM-first runtime for server-rendered websites",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./dist/nemesia.js",
  "module": "./dist/nemesia.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/nemesia.umd.js",
  "jsdelivr": "./dist/nemesia.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nemesia.js",
      "default": "./dist/nemesia.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikitekirsha/nemesia.git"
  },
  "keywords": [
    "nemesia",
    "components",
    "lifecycle",
    "vanilla",
    "dom",
    "progressive-enhancement"
  ],
  "author": "nikitekirsha",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nikitekirsha/nemesia/issues"
  },
  "homepage": "https://github.com/nikitekirsha/nemesia#readme",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.umd.config.ts && tsc -p tsconfig.build.json && tsc -p tests/consumer/tsconfig.json && node --test scripts/verify-build.test.mjs && node scripts/verify-build.mjs",
    "prepack": "npm test && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
