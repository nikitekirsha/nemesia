{
	"name": "nemesia",
	"version": "2.0.1",
	"description": "DOM-first runtime for server-rendered websites",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"main": "./dist/nemesia.js",
	"module": "./dist/nemesia.js",
	"types": "./dist/index.d.ts",
	"unpkg": "./dist/nemesia.umd.js",
	"jsdelivr": "./dist/nemesia.umd.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/nemesia.js",
			"default": "./dist/nemesia.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nikitekirsha/nemesia.git"
	},
	"keywords": [
		"nemesia",
		"components",
		"lifecycle",
		"vanilla",
		"dom",
		"progressive-enhancement"
	],
	"author": "nikitekirsha",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/nikitekirsha/nemesia/issues"
	},
	"homepage": "https://github.com/nikitekirsha/nemesia#readme",
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"build": "vite build && vite build --config vite.umd.config.ts && tsc -p tsconfig.build.json && tsc -p tests/consumer/tsconfig.json && node --test scripts/verify-build.test.mjs && node scripts/verify-build.mjs",
		"precommit": "npm run format:check && npm run typecheck && npm test",
		"verify": "npm run format:check && npm run typecheck && npm test && npm run build && npm pack --dry-run --ignore-scripts",
		"prepack": "npm run format:check && npm test && npm run typecheck && npm run build",
		"prepare": "husky"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"husky": "^9.1.7",
		"jsdom": "^26.1.0",
		"prettier": "^3.9.5",
		"typescript": "^5.8.3",
		"vite": "^7.0.0",
		"vitest": "^3.2.4"
	}
}
